# Copy to `.env` at the repository root before `docker compose up`.
#
# Staging must not share anything with production: separate database, separate
# object storage, separate Pinecone index, separate Clerk instance, separate
# provider keys. Sharing any one of them means a staging test can corrupt, bill,
# or leak production.

POSTGRES_PASSWORD=change-me

# Where a browser reaches the client, and the only origin the API accepts.
# Comma-separated for more than one. Must be https outside development — the API
# refuses to start otherwise.
CLIENT_URL=https://staging.example.com
NEXT_PUBLIC_APP_URL=https://staging.example.com

# How many proxies sit between the internet and the API. Rate limiting keys on
# the client address, and this is how Express finds it. Too high lets a caller
# forge the address they are limited by, so count the hops rather than guessing.
TRUST_PROXY_HOPS=1

# Bearer token for `/health/detail` and `/metrics`. Without it those endpoints do
# not exist. Generate with: openssl rand -hex 32
OPS_TOKEN=

# Clerk — a staging instance, never the production one.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

OPENAI_API_KEY=

# A separate index from production. Sharing one means staging's test notebooks
# are retrievable from production answers.
PINECONE_API_KEY=
PINECONE_INDEX=chaibook-staging

# A separate Cloudinary account or folder prefix, so a staging deletion drill
# cannot destroy production media.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Inngest Cloud keys. Leave blank and use `--profile local-jobs` to run jobs
# against the local dev server instead.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Optional providers. Both are behind a per-account consent switch that starts
# off, so leaving these blank simply means those features are unavailable.
FIRECRAWL_API_KEY=
TAVILY_API_KEY=
MEM0_API_KEY=

LOG_LEVEL=info
