{
  "name": "server",
  "version": "1.0.0",
  "description": "Homeworkcopy API server",
  "main": "dist/index.js",
  "scripts": {
    "dev": "bun run generate && tsx watch src/index.ts",
    "generate": "prisma generate",
    "build": "bun run generate && tsc",
    "start": "node dist/index.js",
    "typecheck": "bun run generate && tsc --noEmit && tsc --project tsconfig.scripts.json",
    "lint": "eslint src --max-warnings=0",
    "test": "bun test --pass-with-no-tests",
    "prisma:validate": "prisma validate",
    "prisma:migrate:status": "prisma migrate status",
    "auth:reconcile": "tsx scripts/reconcile-clerk.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@homeworkcopy/contracts": "workspace:*",
    "@ai-sdk/openai": "^4.0.24",
    "@clerk/express": "^2.1.55",
    "@mendable/firecrawl-js": "^4.31.1",
    "@pinecone-database/pinecone": "^8.1.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@tavily/core": "^0.7.6",
    "ai": "^7.0.42",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "inngest": "^4.13.0",
    "mem0ai": "^3.1.2",
    "multer": "^2.2.0",
    "openai": "^7.1.0",
    "pg": "^8.22.0",
    "unpdf": "^1.8.0",
    "youtube-transcript": "^1.3.1",
    "express-rate-limit": "8.0.1",
    "pino": "9.7.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.2.20",
    "@eslint/js": "9.33.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.1.0",
    "@types/pg": "^8.20.0",
    "prisma": "^7.9.1",
    "tsx": "^4.20.3",
    "eslint": "9.33.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.39.1"
  }
}
