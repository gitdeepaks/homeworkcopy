PORT=8080
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/chaibook
CLIENT_URL=http://localhost:3000

# Clerk authentication
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# Cloudinary (PDF uploads) — unsigned upload preset from Dashboard → Upload → Upload Presets
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
# Required for Audio Overview storage (signed uploads and signed playback URLs).
# Also enables signed download URLs for re-processing older PDF uploads.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firecrawl (website imports)
FIRECRAWL_API_KEY=

# Inngest (local dev — run `npx inngest-cli@latest dev` alongside the server)
INNGEST_DEV=1
# Production only
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# OpenAI — gpt-4o-mini for chat, text-embedding-3-small (1536 dims) for Pinecone
OPENAI_API_KEY=

# Audio Overview text-to-speech. Defaults to the OpenAI adapter, which reuses
# OPENAI_API_KEY. Audio is offered only when a provider and Cloudinary API
# credentials are both configured.
TTS_PROVIDER=openai
TTS_MODEL=gpt-4o-mini-tts

# Audio source transcription. Defaults to the OpenAI adapter, which reuses
# OPENAI_API_KEY. The model must return segment timestamps, or a citation from a
# recording could not point at the moment that supports it. Audio uploads are
# offered only when a provider and Cloudinary API credentials are both
# configured.
STT_PROVIDER=openai
STT_MODEL=whisper-1

# YouTube imports read the video's captions. When a video has none, the audio is
# downloaded and transcribed with the STT provider above instead. That fallback
# needs the yt-dlp, ffmpeg, and ffprobe binaries on PATH. Set to 0 to leave
# caption-less videos as failed imports rather than spending transcription
# budget on them.
YOUTUBE_AUDIO_FALLBACK=1
# Longest video the fallback will transcribe. Transcription is billed by the
# minute, and an archived stream can run for hours.
YOUTUBE_AUDIO_MAX_DURATION_MINUTES=120
# Which player client yt-dlp impersonates, e.g. youtube:player_client=tv.
# YouTube now serves most audio-only formats only against a PO token, and which
# client still works changes every few months — check the yt-dlp issue tracker
# when downloads start failing with HTTP 403.
YTDLP_EXTRACTOR_ARGS=
# Only needed when the binaries are not on PATH.
YTDLP_PATH=
FFMPEG_PATH=
FFPROBE_PATH=
# YouTube blocks many datacentre IPs. A Netscape-format cookies export and/or an
# outbound proxy are the two ways past it.
YTDLP_COOKIES_FILE=
YTDLP_PROXY=

# Pinecone — index is auto-created with 1536 dimensions (cosine) if missing
PINECONE_API_KEY=
PINECONE_INDEX=chaibook

# Optional user memory and web search
MEM0_API_KEY=
TAVILY_API_KEY=

# Optional daily per-user chat budgets (defaults: 100 requests / 500,000 tokens).
# Started provider attempts consume quota even when cancelled or failed.
CHAT_DAILY_REQUEST_LIMIT=100
CHAT_DAILY_TOKEN_LIMIT=500000
